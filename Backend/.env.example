DATABASE_URL=postgresql+asyncpg://skillsphere:change-me@127.0.0.1:5432/skillsphere_db
FRONTEND_URL=http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-private-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIRECTORY=uploads

ADMIN_EMAIL=
ADMIN_PASSWORD=





SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SkillSphere

# Optional HTTPS email delivery for platforms that block outbound SMTP (e.g. Render Free).
# Configure a verified sender with your email provider. When set, this takes precedence over SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudinary private video uploads (keep the API secret on the backend only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional self-hosted Judge0 CE endpoint. Candidate code is never run in FastAPI.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_LANGUAGE_IDS={"python":71,"javascript":63,"cpp":54,"java":62,"go":60}
INTERVIEW_ROOM_TICKET_SECONDS=90
INTERVIEW_STUN_URLS=stun:stun.l.google.com:19302
INTERVIEW_TURN_URLS=
INTERVIEW_TURN_SHARED_SECRET=

# OpenAI-compatible chatbot API (keep the API key on the backend)
CHATBOT_AI_BASE_URL=https://api.openai.com/v1
CHATBOT_AI_API_KEY=
CHATBOT_AI_MODEL=
CHATBOT_AI_TIMEOUT_SECONDS=30

# Private, persistent server-side folder for proctoring camera and screen images
PROCTORING_EVIDENCE_DIR=private_proctoring_evidence
